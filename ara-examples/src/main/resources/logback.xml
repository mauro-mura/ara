<configuration>
    <statusListener class="ch.qos.logback.core.status.NopStatusListener"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="dev.langchain4j"                              level="WARN"/>

    <logger name="io.ara.runtime"                               level="WARN"/>

    <!-- A failed plan step is part of what the planner example shows, and its narrator tells it in
         plain words; the strategy's own WARN line about it would only interrupt the story. -->
    <logger name="io.ara.runtime.strategy.PlanExecuteStrategy"  level="ERROR"/>
    
    <logger name="io.ara.runtime.strategy.ReactStrategy"        level="INFO"/>

    <logger name="io.ara.runtime.llm.LoggingLlmClient"          level="INFO"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
